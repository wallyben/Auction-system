# ARIE owner configuration. Copy to .env and edit. Never commit secrets.

APP_ENV=development
APP_NAME=ARIE
DATABASE_URL=postgresql+psycopg://arie:arie@localhost:5432/arie

HOME_COUNTRY=IE
BASE_CURRENCY=EUR

# Decision thresholds (fractions unless noted)
MIN_PROFIT_EUR=40
MIN_ROI=0.20
MIN_CONFIDENCE=0.55
MAX_CAPITAL_PER_ITEM_EUR=1500
MAX_DAYS_TO_SALE=45
AVAILABLE_CAPITAL_EUR=5000
SAFE_START_MODE=true
SAFE_START_MAX_PURCHASE_EUR=250
MIN_DOWNSIDE_MARGIN=0
MAX_PURCHASE_EUR=1500
MAX_CATEGORY_EXPOSURE=0.40
ALERT_ON=BUY_READY
OWNER_OVERRIDE_UNCERTIFIED=false
CERTIFIED_CATEGORIES=
TARGET_MARGIN_PERCENT=0.15
RISK_PERCENT=0.08
RISK_TOLERANCE=medium

ENABLED_SOURCES=reverb,scryfall,csv_import,manual,rss_generic,ecb_fx,ebay_browse
ENABLED_CATEGORIES=consumer_electronics,computing,cameras,gaming,pro_av,music_dj,collectibles,trading_cards,tools,sporting_goods,hobby,small_business

SCAN_QUERIES=sol ring,lightning bolt,rhystic study,sony a7,canon rf,iphone 14
SCAN_ENABLED=true
FAST_MARKETPLACE_MINUTES=15
SLOW_SOURCE_MINUTES=45
AUCTION_CATALOGUE_MINUTES=180
VALUATION_REFRESH_HOURS=12

# Optional dashboard token. If empty, local dashboard is open.
ARIE_DASHBOARD_TOKEN=

# eBay Browse API (official). Leave empty until you create an app at developer.ebay.com
# Sandbox App IDs contain SBX — ARIE will use sandbox hosts automatically.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=sandbox
EBAY_MARKETPLACES=EBAY_IE,EBAY_GB,EBAY_DE,EBAY_FR,EBAY_IT,EBAY_ES,EBAY_NL

# Marketplace Account Deletion notifications (required to enable a Production keyset).
# Leave empty in this example. Generate a token with `make ebay-notification-token`.
# Never commit the real token. The token is 32-80 chars of A-Z a-z 0-9 _ -
EBAY_NOTIFICATION_VERIFICATION_TOKEN=
# Public HTTPS URL of GET/POST /webhooks/ebay/account-deletion (must match the eBay portal exactly).
EBAY_NOTIFICATION_ENDPOINT_URL=

# Optional marketplace tokens
REVERB_TOKEN=
DISCOGS_TOKEN=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Owner VAT posture. accountant_required until you confirm with an accountant.
OWNER_VAT_REGISTERED=true
OWNER_USES_MARGIN_SCHEME=true
VAT_RATE=0.23

# Platform resale assumptions (fractions). Marked as configurable assumptions in the UI.
EBAY_IE_FINAL_VALUE_FEE=0.129
EBAY_IE_FEE_VAT=0.23
RETURNS_ALLOWANCE=0.03
WARRANTY_ALLOWANCE=0.01
FX_SPREAD=0.012
PAYMENT_FEE_PERCENT=0.019
PAYMENT_FEE_FIXED_EUR=0.25
